                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    A[Presentation Layer\\ncli / server / handlers / SPA] --&gt; B[Application Layer\\nFLORAPipeline]\n    B --&gt; C[Analytics Layer\\nFloraDB / SQL / Views]\n    B --&gt; D[Domain Services\\ndiversity / feature_engineering / ml / reports / viz]\n    B --&gt; E[External Adapters\\ndownloaders / filesystem / config]\n    C --&gt; F[(DuckDB)]\n    E --&gt; G[APIs externas e arquivos locais]\n&quot;&#xa;}" id="7">
