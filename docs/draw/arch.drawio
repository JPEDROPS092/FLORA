                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    A[Dados externos\\nMGnify / EMP / NCBI SRA] --&gt; B[Downloaders em flora.io.downloaders]\n    B --&gt; C[Arquivos locais\\nFASTQ / BIOM / TSV / manifest.tsv / metadata.tsv]\n    C --&gt; D[FLORAPipeline]\n    D --&gt; E[Ingestao em flora.db.ingestion]\n    E --&gt; F[(DuckDB local\\nflora.duckdb)]\n    F --&gt; G[Views analiticas\\nv_asv_tss / v_asv_clr / v_taxonomy_full / v_diversity_wide]\n    G --&gt; H[Feature engineering\\nPolars + SQL]\n    H --&gt; I[Diversidade alfa e beta]\n    H --&gt; J[ML\\nClassificacao / Regressao / Clustering]\n    J --&gt; K[Interpretabilidade\\nFeature importance / SHAP]\n    I --&gt; L[Visualizacoes]\n    J --&gt; L\n    K --&gt; L\n    L --&gt; M[FLORAReport HTML]\n    F --&gt; N[UI local\\nCLI + servidor HTTP + SPA Angular]\n&quot;&#xa;}" id="2">
                    <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" parent="1" vertex="1">
                        <mxGeometry x="60" y="-520" width="723.7468872070312" height="1534.143798828125" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class FloraConfig {\n        +database\n        +pipeline\n        +ml\n        +logging\n        +storage\n    }\n\n    class FLORAPipeline {\n        +config : FloraConfig\n        +workdir : Path\n        +db : FloraDB\n        +ingest_metadata(path)\n        +ingest_asv_table(path, wide_format)\n        +ingest_taxonomy(path)\n        +compute_diversity(sampling_depth, metrics)\n        +get_feature_matrix(normalize, min_prevalence)\n        +close()\n    }\n\n    class FloraDB {\n        +connect(path, threads, memory_limit)\n        +initialize_schema()\n        +create_views()\n        +load_dataframe(table, df, if_exists)\n        +load_parquet(table, parquet_path)\n        +pivot_asv(normalize, min_prevalence)\n        +aggregate_by_taxon(level, group_by, metric)\n        +slice(train_filter, test_filter, features, target_column)\n        +table_info()\n        +query(sql)\n        +close()\n    }\n\n    class QueryResult {\n        +to_polars()\n        +to_pandas()\n        +to_arrow()\n        +to_parquet(path)\n    }\n\n    class MicrobiomeClassifier {\n        +fit(train_df, test_df, cv_folds, run_name)\n    }\n\n    class MicrobiomeRegressor {\n        +fit(train_df, test_df, cv_folds)\n    }\n\n    class MicrobiomeClusterer {\n        +fit(df)\n    }\n\n    class SHAPAnalyzer {\n        +explain(df)\n    }\n\n    class FLORAReport {\n        +add_metrics(title, metrics)\n        +add_table(title, df)\n        +add_plot(title, fig)\n        +save(path)\n    }\n\n    class FLORAState {\n        +config\n        +workdir\n        +pipeline\n    }\n\n    class MGnifyDownloader {\n        +fetch(study_accession, output_dir, max_samples)\n        +fetch_analyses(study_accession, output_dir, max_analyses)\n    }\n\n    class NCBISRADownloader {\n        +fetch(accessions, output_dir)\n    }\n\n    class EMPDownloader {\n        +fetch(output_dir, max_samples)\n    }\n\n    FLORAPipeline --&gt; FloraConfig\n    FLORAPipeline --&gt; FloraDB\n    FloraDB --&gt; QueryResult\n    FLORAPipeline --&gt; MicrobiomeClassifier\n    FLORAPipeline --&gt; MicrobiomeRegressor\n    FLORAPipeline --&gt; MicrobiomeClusterer\n    MicrobiomeClassifier --&gt; SHAPAnalyzer\n    FLORAPipeline --&gt; FLORAReport\n    FLORAState --&gt; FLORAPipeline\n    FLORAPipeline --&gt; MGnifyDownloader\n    FLORAPipeline --&gt; NCBISRADownloader\n    FLORAPipeline --&gt; EMPDownloader\n&quot;&#xa;}" id="3">
                    <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" parent="1" vertex="1">
                        <mxGeometry x="1590" y="-700" width="3327.40625" height="1210" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class samples {\n        sample_id PK\n        biome\n        location\n        latitude\n        longitude\n        sequencing_depth\n    }\n\n    class sample_metadata {\n        sample_id FK\n        key PK\n        value\n    }\n\n    class asv {\n        sample_id FK\n        feature_id PK\n        abundance\n    }\n\n    class taxonomy {\n        feature_id PK\n        kingdom\n        phylum\n        class\n        order\n        family\n        genus\n        species\n        confidence\n    }\n\n    class diversity_alpha {\n        sample_id FK\n        metric PK\n        value\n        sampling_depth\n    }\n\n    class diversity_beta {\n        sample_a\n        sample_b\n        metric\n        distance\n    }\n\n    class dim_reduction {\n        sample_id FK\n        method\n        component\n        value\n    }\n\n    class pipeline_log {\n        run_id\n        step\n        status\n        started_at\n        finished_at\n        params\n        message\n    }\n\n    samples \&quot;1\&quot; --&gt; \&quot;*\&quot; sample_metadata : possui\n    samples \&quot;1\&quot; --&gt; \&quot;*\&quot; asv : observa\n    taxonomy \&quot;1\&quot; --&gt; \&quot;*\&quot; asv : anota\n    samples \&quot;1\&quot; --&gt; \&quot;*\&quot; diversity_alpha : resume\n    samples \&quot;1\&quot; --&gt; \&quot;*\&quot; dim_reduction : projeta\n&quot;&#xa;}" id="4">
                    <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" parent="1" vertex="1">
                        <mxGeometry x="1990" y="900" width="905.6402587890625" height="591.5999755859375" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject label="https://www.linkedin.com/posts/generalrodolfao_boa-tarde-tropa-divulgando-para-ajudar-share-7450298654151696384-m3TC/" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    subgraph Externo\n        A[MGnify REST API]\n        B[NCBI SRA]\n        C[EMP portal / Qiita]\n    end\n\n    subgraph Conectores\n        D[MGnifyDownloader]\n        E[NCBISRADownloader]\n        F[EMPDownloader]\n    end\n\n    subgraph DiscoLocal\n        G[data/raw/fastq]\n        H[metadata.tsv]\n        I[manifest.tsv]\n        J[asv_table.tsv]\n        K[taxonomy.tsv]\n        L[cache parquet/]\n    end\n\n    subgraph Ingestao\n        M[ingest_metadata]\n        N[ingest_tsv_asv / ingest_biom]\n        O[ingest_taxonomy]\n    end\n\n    A --&gt; D\n    B --&gt; E\n    C --&gt; F\n    D --&gt; G\n    D --&gt; H\n    D --&gt; I\n    D --&gt; J\n    D --&gt; K\n    E --&gt; G\n    E --&gt; I\n    F --&gt; H\n    F --&gt; J\n    F --&gt; K\n    H --&gt; M\n    J --&gt; N\n    K --&gt; O\n    N --&gt; L\n    M --&gt; P[(DuckDB)]\n    N --&gt; P\n    O --&gt; P\n&quot;&#xa;}" id="5">
