    <diagram id="wPdQ15Jz1U5Evv34MfIb" name="Page-1">
        <mxGraphModel dx="64" dy="2071" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class FloraConfig {\n        +database\n        +pipeline\n        +ml\n        +logging\n        +storage\n    }\n\n    class FLORAPipeline {\n        +config : FloraConfig\n        +workdir : Path\n        +db : FloraDB\n        +ingest_metadata(path)\n        +ingest_asv_table(path, wide_format)\n        +ingest_taxonomy(path)\n        +compute_diversity(sampling_depth, metrics)\n        +get_feature_matrix(normalize, min_prevalence)\n        +close()\n    }\n\n    class FloraDB {\n        +connect(path, threads, memory_limit)\n        +initialize_schema()\n        +create_views()\n        +load_dataframe(table, df, if_exists)\n        +load_parquet(table, parquet_path)\n        +pivot_asv(normalize, min_prevalence)\n        +aggregate_by_taxon(level, group_by, metric)\n        +slice(train_filter, test_filter, features, target_column)\n        +table_info()\n        +query(sql)\n        +close()\n    }\n\n    class QueryResult {\n        +to_polars()\n        +to_pandas()\n        +to_arrow()\n        +to_parquet(path)\n    }\n\n    class MicrobiomeClassifier {\n        +fit(train_df, test_df, cv_folds, run_name)\n    }\n\n    class MicrobiomeRegressor {\n        +fit(train_df, test_df, cv_folds)\n    }\n\n    class MicrobiomeClusterer {\n        +fit(df)\n    }\n\n    class SHAPAnalyzer {\n        +explain(df)\n    }\n\n    class FLORAReport {\n        +add_metrics(title, metrics)\n        +add_table(title, df)\n        +add_plot(title, fig)\n        +save(path)\n    }\n\n    class FLORAState {\n        +config\n        +workdir\n        +pipeline\n    }\n\n    class MGnifyDownloader {\n        +fetch(study_accession, output_dir, max_samples)\n        +fetch_analyses(study_accession, output_dir, max_analyses)\n    }\n\n    class NCBISRADownloader {\n        +fetch(accessions, output_dir)\n    }\n\n    class EMPDownloader {\n        +fetch(output_dir, max_samples)\n    }\n\n    FLORAPipeline --&gt; FloraConfig\n    FLORAPipeline --&gt; FloraDB\n    FloraDB --&gt; QueryResult\n    FLORAPipeline --&gt; MicrobiomeClassifier\n    FLORAPipeline --&gt; MicrobiomeRegressor\n    FLORAPipeline --&gt; MicrobiomeClusterer\n    MicrobiomeClassifier --&gt; SHAPAnalyzer\n    FLORAPipeline --&gt; FLORAReport\n    FLORAState --&gt; FLORAPipeline\n    FLORAPipeline --&gt; MGnifyDownloader\n    FLORAPipeline --&gt; NCBISRADownloader\n    FLORAPipeline --&gt; EMPDownloader\n&quot;&#xa;}" id="2">
