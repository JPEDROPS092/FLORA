                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;flowchart&#39;: {&#39;nodeSpacing&#39;: 12, &#39;rankSpacing&#39;: 20, &#39;curve&#39;: &#39;linear&#39;}}}%%\nflowchart LR\n\n    %% === FONTES EXTERNAS ===\n    subgraph EXT[\&quot;Fontes Externas\&quot;]\n        direction TB\n        MG[\&quot;MGnify API\&quot;]\n        SRA[\&quot;NCBI SRA\&quot;]\n        EMP[\&quot;Earth Microbiome Project\&quot;]\n    end\n\n    %% === INGESTÃO &amp; VALIDAÇÃO ===\n    subgraph IO[\&quot;flora.io\&quot;]\n        direction TB\n        DL[\&quot;downloaders.py\&quot;]\n        VAL[\&quot;validators.py\&quot;]\n    end\n\n    %% === ARMAZENAMENTO LOCAL ===\n    subgraph LOCAL[\&quot;Armazenamento Local (data/raw/)\&quot;]\n        direction TB\n        TSV[\&quot;metadata.tsv\\nasv_table.tsv\\ntaxonomy.tsv\&quot;]\n        BIOM[\&quot;*.biom\&quot;]\n        PARQ[\&quot;*.parquet\&quot;]\n        MANIF[\&quot;manifest.tsv\&quot;]\n    end\n\n    %% === BANCO DE DADOS ===\n    subgraph DB[\&quot;flora.db - FloraDB (DuckDB)\&quot;]\n        direction TB\n        SCHEMA[\&quot;schema.py\&quot;]\n        VIEWS[\&quot;views\&quot;]\n        INGEST[\&quot;ingestion.py\&quot;]\n    end\n\n    %% === ORQUESTRAÇÃO ===\n    subgraph PIPE[\&quot;flora.pipelines - FLORAPipeline\&quot;]\n        direction TB\n        ORCH[\&quot;main_pipeline.py\&quot;]\n    end\n\n    %% === ANÁLISE ===\n    subgraph ANALYTICS[\&quot;Camadas Analíticas\&quot;]\n        direction TB\n        FE[\&quot;feature_engineering\&quot;]\n        DIV[\&quot;diversity\&quot;]\n        ML[\&quot;ml\&quot;]\n    end\n\n    %% === SAÍDAS ===\n    subgraph OUT[\&quot;Saídas\&quot;]\n        direction TB\n        VIZ[\&quot;flora.viz\&quot;]\n        REP[\&quot;flora.reports\&quot;]\n        UI[\&quot;flora.ui\&quot;]\n    end\n\n    %% === CONEXÕES PRINCIPAIS ===\n    EXT --&gt; IO --&gt; LOCAL --&gt; DB --&gt; PIPE --&gt; ANALYTICS --&gt; OUT\n\n    %% === CONEXÕES DETALHAD